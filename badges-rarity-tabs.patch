 /* ---------- Rozetler ---------- */
 .badges { margin: 0; }
+.badge-rarity-tabs {
+  display: flex; gap: 6px; margin: 2px 0 12px; padding: 3px; overflow-x: auto;
+  scrollbar-width: none; border-radius: 12px; background: color-mix(in srgb, var(--paper) 72%, transparent);
+}
+.badge-rarity-tabs::-webkit-scrollbar { display: none; }
+.badge-rarity-tabs button {
+  flex: 0 0 auto; border: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
+  border-radius: 999px; padding: 6px 10px; background: var(--surface); color: var(--muted);
+  font: 750 10.5px/1 var(--text); cursor: pointer; white-space: nowrap;
+}
+.badge-rarity-tabs button:hover { color: var(--ink); }
+.badge-rarity-tabs button[aria-selected="true"] {
+  background: var(--accent); color: var(--accent-ink); border-color: var(--accent);
+  box-shadow: 0 2px 7px rgba(0, 0, 0, .10);
+}
+.badge-rarity-tabs button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
+.badge-rarity-tabs button[hidden] { display: none; }
+.badge-category-meta {
+  display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 2px 10px;
+  color: var(--muted); font-size: 10.5px;
+}
+.badge-category-meta strong { color: var(--ink); font-size: 12px; }
 .badge-grid {
