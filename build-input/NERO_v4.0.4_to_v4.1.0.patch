+  'todayProductivityAboveRecentAverage', 'last3ActiveDaysConsistent',
+  'recent7FocusMin', 'recent7FocusVsPrevious7MinRatio', 'recent7TodosMin', 'recent7TodosVsPrevious7MinRatio',
