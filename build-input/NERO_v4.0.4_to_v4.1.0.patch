+function interpolateDialogue(text, vars) {
+  return String(text || '').replace(/\{(\w+)\}/g, (m, key) => (vars[key] !== undefined && vars[key] !== null ? String(vars[key]) : m));
+}
+
+function validateDialogueData(data = DATA) {
