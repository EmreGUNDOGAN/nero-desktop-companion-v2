+    else if (ids.has(d.id)) errors.push(`${at}: duplicate id ${d.id}`);
+    else ids.add(d.id);
+    if (!d.text || typeof d.text !== 'string') errors.push(`${at}: metin eksik`);
+    else if (texts.has(d.text)) errors.push(`${at}: duplicate metin`);
+    else texts.add(d.text);
