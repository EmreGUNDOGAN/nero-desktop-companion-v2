+    if (cond.timeStart && parseClock(cond.timeStart) === null) errors.push(`${at}: geçersiz timeStart`);
+    if (cond.timeEndInclusive && parseClock(cond.timeEndInclusive) === null) errors.push(`${at}: geçersiz timeEndInclusive`);
