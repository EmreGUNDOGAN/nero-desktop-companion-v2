+function maxRolling(history, days, field) {
+  if (!Array.isArray(history) || !history.length) return 0;
+  let best = 0;
+  for (let i = 0; i < history.length; i++) {
+    const slice = history.slice(Math.max(0, i - days + 1), i + 1);
+    best = Math.max(best, slice.reduce((a, d) => a + (Number(d[field]) || 0), 0));
+  }
+  return best;
+}
+function rollingCompletionRatio(history, days) {
+  const slice = Array.isArray(history) ? history.slice(-days) : [];
+  const created = slice.reduce((a, d) => a + (Number(d.todosCreated) || 0), 0);
+  const done = slice.reduce((a, d) => a + (Number(d.todos) || 0), 0);
+  return created > 0 ? Math.min(1, done / created) : 0;
+}
+function hasCalendarStreak(history, need, predicate) {
+  let run = 0, previous = null;
+  for (const row of Array.isArray(history) ? history : []) {
+    if (previous) {
+      const gap = Math.round((new Date(row.day + 'T12:00:00') - new Date(previous + 'T12:00:00')) / 86400000);
+      if (gap !== 1) run = 0;
+    }
+    run = predicate(row) ? run + 1 : 0;
+    if (run >= need) return true;
+    previous = row.day;
+  }
+  return false;
+}
 
