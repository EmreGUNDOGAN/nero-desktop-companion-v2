{
  "name": "nero",
  "productName": "Nero",
  "version": "6.9.13",
  "description": "Nero - huysuz ama seni seven masaüstü arkadaşın",
  "main": "src/main/main.js",
  "author": {
    "name": "Stenwick"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --win --x64 --dir --publish never",
    "test": "node --test test/*.test.js",
    "dialogue:build": "node scripts/dialogue-master.js",
    "dialogue:check": "node scripts/dialogue-master.js --check",
    "dialogue:import": "node scripts/dialogue-import.js",
    "wardrobe:build": "node scripts/build-wardrobe.js",
    "wardrobe:build-new": "node scripts/wardrobe-v665/build-assets.js",
    "finance:build": "node scripts/build-finance-ui.js",
    "finance:check": "tsc -p tsconfig.finance.json"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.stenwick.nero",
    "productName": "Nero",
    "copyright": "Copyright © 2026 Stenwick",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "docs/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "themes"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "Stenwick"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nero",
      "uninstallDisplayName": "Nero",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "warningsAsErrors": false,
      "runAfterFinish": true,
      "artifactName": "Nero-Setup-${version}.exe",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "tr_TR"
      ],
      "language": "1055"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EmreGUNDOGAN",
        "repo": "nero-desktop-companion-v2",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "clsx": "2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "14.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  }
}
