+    inputEl.onblur = null;
+    inputEl.hidden = true;
+    labelEl.hidden = false;
+    const v = inputEl.value.trim();
+    if (save && v && v !== current) onSave(v);
+  };
+  inputEl.onkeydown = (e) => { if (e.key === 'Enter') finish(true); if (e.key === 'Escape') { e.stopPropagation(); finish(false); } };
